{
  "name": "@constractor/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "db:backup": "docker exec constructor-site-management-postgres pg_dump -U constractor constractor_dev > ./backups/constractor_dev_$(date +%Y%m%d_%H%M%S).sql && echo 'Backup saved to ./backups/'",
    "db:restore": "node -e \"const f=process.argv[1]; if(!f){console.error('Usage: pnpm db:restore <file>');process.exit(1)}\" --",
    "db:migrate": "node --env-file=.env --import tsx/esm src/database/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx/esm src/database/seeds/dev-users.ts",
    "db:seed-test": "node --env-file=.env --import tsx/esm src/database/seeds/seed-test-users.ts",
    "db:create-test": "docker exec constructor-site-management-postgres createdb -U constractor constractor_test || true",
    "db:migrate-test": "node --env-file=.env.test --import tsx/esm src/database/migrate.ts",
    "test": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs",
    "test:coverage": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@constractor/config": "workspace:*",
    "@constractor/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^4.1.5"
  }
}
